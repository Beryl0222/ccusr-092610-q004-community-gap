{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "社区便民服务缺口裁决台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "COMMUNITY_REVISED",
        "NEED_AGGREGATED",
        "NEED_WITHDRAWN",
        "CONSENT_WITHDRAWN",
        "REVIEW_REQUESTED",
        "SITE_PROPOSED",
        "SITE_STATUS_CHANGED",
        "FUND_RESERVED",
        "COVERAGE_REVIEWED",
        "SITE_VERIFIED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "community_revision",
        "service_need",
        "provider_site",
        "coverage_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "NEED_AGGREGATED": [
      "community_revision",
      "category"
    ],
    "FUND_RESERVED": [
      "funding_round",
      "amount"
    ],
    "SITE_VERIFIED": [
      "evidence_set",
      "verified_by"
    ],
    "SITE_PROPOSED": [
      "applicant_id",
      "categories",
      "location_km",
      "serves_communities"
    ],
    "COVERAGE_REVIEWED": [
      "community_revision",
      "need_id",
      "reviewer_id",
      "applicant_id",
      "category"
    ],
    "COMMUNITY_REVISED": [
      "community_id",
      "revision_no",
      "service_radius_km"
    ]
  },
  "additionalProperties": false
}
